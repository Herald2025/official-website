---
interface Props {
    text: string;
}

const { text } = Astro.props;
---

<div
    class="section-divider flex items-center gap-6 max-w-5xl mx-auto px-4 sm:px-6 lg:px-8 py-2"
>
    <div
        class="flex-1 h-px bg-gradient-to-r from-transparent via-gray-300 dark:via-gray-600 to-gray-300 dark:to-gray-600"
    >
    </div>
    <span
        class="text-sm md:text-base font-medium text-gray-400 dark:text-gray-500 whitespace-nowrap tracking-wide"
    >
        {text}
    </span>
    <div
        class="flex-1 h-px bg-gradient-to-l from-transparent via-gray-300 dark:via-gray-600 to-gray-300 dark:to-gray-600"
    >
    </div>
</div>
