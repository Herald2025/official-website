---
import { projects } from "../data/projects";
---

<section
  id="projects"
  class="py-20 md:py-32 bg-gray-50 dark:bg-gray-950 transition-colors duration-300"
>
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
    <div class="text-center mb-16">
      <h2
        class="text-3xl md:text-4xl font-bold text-gray-900 dark:text-white mb-4"
      >
        我们的项目
      </h2>
      <p class="text-lg text-gray-600 dark:text-gray-400 max-w-3xl mx-auto">
        多年来，我们开发了多款服务东大师生的应用，涵盖校园生活的方方面面
      </p>
    </div>

    <div class="space-y-12">
      {
        projects.map((project, index) => (
          <a
            href={`/projects/${project.id}`}
            class:list={[
              "project-card group block md:flex items-stretch bg-white dark:bg-gray-900 rounded-2xl overflow-hidden border border-gray-200 dark:border-gray-800 transition-all duration-300 hover:shadow-xl hover:border-primary",
              index % 2 !== 0 ? "md:flex-row-reverse" : "",
            ]}
          >
            <div class="md:w-1/2 aspect-video md:aspect-auto bg-gray-200 dark:bg-gray-800 overflow-hidden">
              <img
                src={project.image}
                alt={project.title}
                class="w-full h-full object-cover transition-transform duration-500"
                onerror="this.src='https://via.placeholder.com/600x400?text=Project+Image'"
              />
            </div>
            <div class="md:w-1/2 p-8 flex flex-col justify-center">
              <h3 class="project-title text-2xl font-bold text-gray-900 dark:text-white mb-3">
                {project.title}
              </h3>
              <p class="text-gray-600 dark:text-gray-400 mb-5 leading-relaxed">
                {project.description}
              </p>
              <div class="flex flex-wrap gap-2">
                {project.tags.map((tag) => (
                  <span class="px-3 py-1 text-xs font-medium bg-gray-100 dark:bg-gray-800 text-gray-700 dark:text-gray-300 rounded-full">
                    {tag}
                  </span>
                ))}
              </div>
            </div>
          </a>
        ))
      }
    </div>
  </div>
</section>

<style>
  .project-card {
    transition:
      transform 0.4s ease,
      box-shadow 0.4s ease,
      border-color 0.4s ease;
  }

  .project-card:hover {
    transform: scale(1.02);
    border-color: var(--primary-color);
    box-shadow: 0 8px 30px rgba(var(--primary-color-rgb), 0.2);
  }

  .project-title {
    transition:
      color 0.5s ease-out,
      letter-spacing 0.5s ease-out,
      text-shadow 0.5s ease-out;
  }

  :global(.group:hover) .project-title {
    color: var(--primary-color);
    letter-spacing: 0.02em;
    text-shadow: 0 1px 8px rgba(var(--primary-color-rgb), 0.25);
  }
</style>
