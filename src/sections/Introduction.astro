---
const milestones = [
  {
    year: '2015',
    title: '工作室成立',
    description: '一群热爱技术的学生在东南大学成立了小猴偷米工作室',
  },
  {
    year: '2016',
    title: '首个产品上线',
    description: '小猴偷米App正式上线，为东大师生提供便捷的校园服务',
  },
  {
    year: '2018',
    title: '用户突破5万',
    description: '累计服务用户超过5万人，成为东大最受欢迎的校园应用',
  },
  {
    year: '2020',
    title: '技术升级',
    description: '全面重构技术架构，引入微服务架构，提升系统稳定性',
  },
  {
    year: '2023',
    title: '持续创新',
    description: '持续推出新功能，服务更多东大师生',
  },
];
---

<section id="introduction" class="py-20 md:py-32 bg-white dark:bg-black transition-colors duration-300">
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
    <div class="text-center mb-16">
      <h2 class="text-3xl md:text-4xl font-bold text-gray-900 dark:text-white mb-4">
        关于我们
      </h2>
      <p class="text-lg text-gray-600 dark:text-gray-400 max-w-3xl mx-auto">
        小猴偷米是东南大学学生自主创立的技术工作室，致力于为校园生活提供便捷的技术解决方案。
      </p>
    </div>

    <!-- Timeline -->
    <div class="relative">
      <!-- Timeline line -->
      <div class="absolute left-1/2 transform -translate-x-1/2 w-0.5 h-full bg-gray-200 dark:bg-gray-800 hidden md:block" />

      <div class="space-y-12">
        {milestones.map((milestone, index) => (
          <div class={`relative flex items-center ${index % 2 === 0 ? 'md:flex-row' : 'md:flex-row-reverse'}`}>
            <!-- Content -->
            <div class="w-full md:w-1/2 px-4 md:px-8">
              <div class={`bg-gray-50 dark:bg-gray-900 p-6 rounded-xl border border-gray-200 dark:border-gray-800 hover:border-primary transition-colors duration-300 ${index % 2 === 0 ? 'md:text-right' : 'md:text-left'}`}>
                <span class="inline-block px-3 py-1 text-sm font-medium text-white bg-primary rounded-full mb-3">
                  {milestone.year}
                </span>
                <h3 class="text-xl font-bold text-gray-900 dark:text-white mb-2">
                  {milestone.title}
                </h3>
                <p class="text-gray-600 dark:text-gray-400">
                  {milestone.description}
                </p>
              </div>
            </div>

            <!-- Timeline dot -->
            <div class="absolute left-1/2 transform -translate-x-1/2 w-4 h-4 bg-primary rounded-full border-4 border-white dark:border-black hidden md:block" />

            <!-- Spacer for the other side -->
            <div class="hidden md:block w-1/2" />
          </div>
        ))}
      </div>
    </div>

    <!-- Stats -->
    <div class="mt-20 grid grid-cols-2 md:grid-cols-4 gap-8">
      <div class="text-center">
        <div class="text-4xl font-bold text-primary mb-2">10万+</div>
        <div class="text-gray-600 dark:text-gray-400">累计用户</div>
      </div>
      <div class="text-center">
        <div class="text-4xl font-bold text-primary mb-2">20+</div>
        <div class="text-gray-600 dark:text-gray-400">团队成员</div>
      </div>
      <div class="text-center">
        <div class="text-4xl font-bold text-primary mb-2">8年</div>
        <div class="text-gray-600 dark:text-gray-400">服务历程</div>
      </div>
      <div class="text-center">
        <div class="text-4xl font-bold text-primary mb-2">10+</div>
        <div class="text-gray-600 dark:text-gray-400">产品项目</div>
      </div>
    </div>
  </div>
</section>
