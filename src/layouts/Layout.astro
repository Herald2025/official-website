---
import { ClientRouter } from "astro:transitions";

interface Props {
  title?: string;
}

const { title = "小猴偷米 - 东南大学学生开发工作室" } = Astro.props;
---

<!doctype html>
<html lang="zh-CN">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <link rel="icon" href="/favicon/icon.png" />
    <meta
      name="description"
      content="小猴偷米 - 东南大学学生开发工作室，致力于为校园生活提供便捷的技术解决方案"
    />
    <title>{title}</title>
    <ClientRouter />
    <script is:inline>
      function resolveTheme() {
        const savedMode = localStorage.getItem("darkMode");
        return savedMode === "dark" ||
          (!savedMode &&
            window.matchMedia("(prefers-color-scheme: dark)").matches)
          ? "dark"
          : "light";
      }

      function applyTheme(targetDocument, mode) {
        const root = targetDocument.documentElement;
        if (mode === "dark") {
          root.classList.add("dark");
          root.dataset.theme = "dark";
        } else {
          root.classList.remove("dark");
          root.dataset.theme = "light";
        }
      }

      // Prevent flash of wrong theme
      (function () {
        applyTheme(document, resolveTheme());
      })();

      // Expose global toggle for any component to use
      window.toggleDarkMode = function () {
        var next = resolveTheme() === "dark" ? "light" : "dark";
        localStorage.setItem("darkMode", next);
        applyTheme(document, next);
      };

      // Re-apply theme BEFORE ClientRouter swaps in the new page DOM
      document.addEventListener("astro:before-swap", function (e) {
        applyTheme(e.newDocument, resolveTheme());
      });
    </script>
    <style is:global>
      @import "../styles/global.css";
    </style>
  </head>
  <body
    class="bg-white dark:bg-black text-gray-900 dark:text-white transition-colors duration-300"
  >
    <slot />
  </body>
</html>
